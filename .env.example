# Copy to .env (npm run setup does this for local development).
DATABASE_URL="file:./dev.db"

# ---- Required in production -------------------------------------------------
# Random string, 32+ chars (e.g. `openssl rand -hex 32`). Signs session cookies.
AUTH_SECRET=""
# Comma-separated emails that become Student-Affairs admins on first OTP sign-in.
ADMIN_EMAILS=""
# Only these email domains (and their subdomains) can register.
ALLOWED_EMAIL_DOMAINS="iiita.ac.in"

# ---- OTP / notification email (Brevo or SendGrid HTTP API) -------------------
EMAIL_PROVIDER=""          # brevo | sendgrid
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""      # must be a sender/domain verified with your provider
EMAIL_FROM_NAME="CampusCrew"

# ---- Demo mode (local trials only) --------------------------------------------
# "true": seeds SAMPLE accounts/trips, shows the OTP on screen when no email provider is set,
# enables one-click demo login and simulated GPS. MUST be "false" (or unset) in production.
DEMO_MODE="false"
