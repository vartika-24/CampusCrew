# Copy to .env (npm run setup does this automatically)
DATABASE_URL="file:./dev.db"
# Secret used to sign session cookies. CHANGE in production.
AUTH_SECRET="change-me-to-a-long-random-string"
# Demo mode: shows the simulated OTP on screen and enables one-click demo login.
# Set to "false" in production.
DEMO_MODE="true"
# Domains accepted for college email (comma separated suffixes)
ALLOWED_EMAIL_SUFFIXES=".ac.in,.edu,.edu.in"
