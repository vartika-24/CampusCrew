# Copy to .env (npm run setup does this for local development).
DATABASE_URL="file:./dev.db"

# ---- Required in production -------------------------------------------------
# Random string, 32+ chars (e.g. `openssl rand -hex 32`). Signs session cookies.
AUTH_SECRET=""
# Only these email domains (and their subdomains) can register.
ALLOWED_EMAIL_DOMAINS="iiita.ac.in"
# Comma-separated Student-Affairs emails; each becomes an admin on first OTP sign-in
# (admins ALWAYS need an emailed code, even when AUTH_MODE=instant).
ADMIN_EMAILS=""

# ---- How students sign in ------------------------------------------------------
# "otp"     : a one-time code is emailed (needs the email settings below)   <- secure default
# "instant" : typing a college email signs you in directly, no code. Good for a demo / pilot,
#             but anyone who knows a classmate's email could sign in as them.
AUTH_MODE="otp"
# "true": signup needs a government-ID photo, gender is read from it.  "false": no ID step;
# the student picks their gender at signup (locked afterwards).
REQUIRE_GOV_ID="true"
# Add the IIITA pickup points / hubs on first boot when there are no places yet ("false" to skip).
LOAD_STARTER_PLACES="true"

# ---- OTP / notification email (Brevo or SendGrid HTTP API) -------------------
EMAIL_PROVIDER=""          # brevo | sendgrid
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""      # must be a sender/domain verified with your provider
EMAIL_FROM_NAME="CampusCrew"

# ---- Demo mode (sample accounts + sample data) -----------------------------------
# "true" seeds SAMPLE accounts/trips, enables one-click demo login and simulated GPS.
# Keep "false" for real use.
DEMO_MODE="false"
